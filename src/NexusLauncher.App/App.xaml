<Application x:Class="NexusLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="NexusBackgroundColor">#10131C</Color>
      <Color x:Key="NexusPanelColor">#181D29</Color>
      <Color x:Key="NexusPanelRaisedColor">#202737</Color>
      <Color x:Key="NexusTextColor">#F7F9FC</Color>
      <Color x:Key="NexusMutedTextColor">#A4AEC2</Color>
      <Color x:Key="NexusAccentColor">#7B6CFF</Color>
      <Color x:Key="NexusAccentHoverColor">#958AFF</Color>
      <SolidColorBrush x:Key="NexusBackground" Color="{StaticResource NexusBackgroundColor}" />
      <SolidColorBrush x:Key="NexusPanel" Color="{StaticResource NexusPanelColor}" />
      <SolidColorBrush x:Key="NexusPanelRaised" Color="{StaticResource NexusPanelRaisedColor}" />
      <SolidColorBrush x:Key="NexusText" Color="{StaticResource NexusTextColor}" />
      <SolidColorBrush x:Key="NexusMutedText" Color="{StaticResource NexusMutedTextColor}" />
      <SolidColorBrush x:Key="NexusAccent" Color="{StaticResource NexusAccentColor}" />
      <SolidColorBrush x:Key="NexusAccentHover" Color="{StaticResource NexusAccentHoverColor}" />

      <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource NexusBackground}" />
        <Setter Property="Foreground" Value="{StaticResource NexusText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NexusText}" />
        <Setter Property="Background" Value="{StaticResource NexusPanelRaised}" />
        <Setter Property="BorderBrush" Value="#32405A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#2B3449" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.78" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.43" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource NexusAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource NexusAccent}" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="#121722" />
        <Setter Property="Foreground" Value="{StaticResource NexusText}" />
        <Setter Property="BorderBrush" Value="#354057" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CaretBrush" Value="{StaticResource NexusText}" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#121722" />
        <Setter Property="Foreground" Value="{StaticResource NexusText}" />
        <Setter Property="BorderBrush" Value="#354057" />
        <Setter Property="Padding" Value="8,5" />
      </Style>
      <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource NexusText}" />
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource NexusText}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
