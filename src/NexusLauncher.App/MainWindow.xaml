<Window x:Class="NexusLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexusLauncher.App.ViewModels"
        xmlns:models="clr-namespace:NexusLauncher.App.Models"
        xmlns:infra="clr-namespace:NexusLauncher.App.Infrastructure"
        Title="Nexus Launcher"
        Icon="Assets/NexusLauncher.ico"
        Width="1380"
        Height="840"
        MinWidth="860"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource NexusBackground}"
        Foreground="{DynamicResource NexusText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <Window.InputBindings>
    <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:LibraryIconConverter x:Key="LibraryIconConverter" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NexusText}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="SidebarItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Foreground" Value="{DynamicResource NexusMutedText}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="indicator"
                      Width="3"
                      Background="Transparent"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      Margin="0,7,0,7" />
              <Border x:Name="surface"
                      Background="Transparent"
                      CornerRadius="10"
                      Margin="5,0,0,0"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="indicator" Property="Background" Value="{DynamicResource NexusAccent}" />
                <Setter TargetName="surface" Property="Background" Value="{DynamicResource NexusSelected}" />
                <Setter Property="Foreground" Value="{DynamicResource NexusText}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="surface" Property="Background" Value="{DynamicResource NexusHover}" />
                <Setter Property="Foreground" Value="{DynamicResource NexusText}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource NexusFocus}" />
                <Setter TargetName="surface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryItemContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="surface"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="surface" Property="Background" Value="{DynamicResource NexusSelected}" />
                <Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource NexusAccent}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="surface" Property="Background" Value="{DynamicResource NexusHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource NexusFocus}" />
                <Setter TargetName="surface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource NexusPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NexusBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SearchFieldBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource NexusInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NexusBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource NexusFocus}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="31" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource NexusText}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource NexusText}" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource NexusAccentText}" />
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource NexusBorder}" />
    </Style>

    <Style x:Key="SmallPill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource NexusHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NexusBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <DataTemplate x:Key="MiniItem" DataType="{x:Type models:LibraryItem}">
      <Border Width="230"
              Height="142"
              Margin="0,0,14,0"
              Background="{DynamicResource NexusPanel}"
              BorderBrush="{DynamicResource NexusBorder}"
              BorderThickness="1"
              CornerRadius="14"
              ClipToBounds="True">
        <Grid>
          <Border Opacity="0.96">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8B5CF6" Offset="0" />
                <GradientStop Color="#385EEA" Offset="0.58" />
                <GradientStop Color="#152342" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Ellipse Width="130" Height="130" Fill="#3FFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-55,-44,0" />
          <Border Background="#95060A12" />
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
              <Border Width="38"
                    Height="38"
                    Background="#E9303658"
                    CornerRadius="11"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ClipToBounds="True">
              <Grid>
                <Image Source="Assets/nexus-logo-512.png" Opacity="0.14" Stretch="UniformToFill" />
                <TextBlock Text="{Binding Initial}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Image Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.Source>
                    <MultiBinding Converter="{StaticResource LibraryIconConverter}">
                      <Binding Path="IconPath" />
                      <Binding Path="ExecutablePath" />
                    </MultiBinding>
                  </Image.Source>
                </Image>
              </Grid>
            </Border>
            <StackPanel Grid.Row="1">
              <TextBlock Text="{Binding CategoryLabel}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="#D8E7EEFF" />
              <TextBlock Text="{Binding Name}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="White"
                         Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding LaunchActivityDisplay}"
                         FontSize="10"
                         Foreground="#D5E7EEFF"
                         Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="YOUR DESKTOP, ORGANIZED" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
              <TextBlock Text="{Binding Subtitle}"
                         Foreground="{DynamicResource NexusMutedText}"
                         Margin="0,7,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Rescan library"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    VerticalAlignment="Center" />
          </Grid>

          <Border Height="236"
                  Margin="0,0,0,22"
                  BorderBrush="#5E7B6CFF"
                  BorderThickness="1"
                  CornerRadius="20"
                  ClipToBounds="True">
            <Grid>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2424476B" Offset="0" />
                    <GradientStop Color="#263B287D" Offset="0.55" />
                    <GradientStop Color="#2B7B6CFF" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Ellipse Width="330" Height="330" Fill="#157B6CFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-90,0" />
              <Ellipse Width="210" Height="210" Fill="#1269D8FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,110,-125" />
              <Path Data="M0,58 C80,-12 156,126 260,48 S446,-18 560,42"
                    Stroke="#6AA29CFF"
                    StrokeThickness="2"
                    Opacity="0.55"
                    Stretch="None"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,38,80,0" />
              <Grid Margin="30">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MaxWidth="620">
                  <Border Style="{StaticResource SmallPill}" HorizontalAlignment="Left" Background="#243B55A4" BorderBrush="#4FAD9EFF">
                    <TextBlock Text="LOCAL-FIRST LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NexusText}" />
                  </Border>
                  <TextBlock Text="Everything you play, in one calm place."
                             FontSize="28"
                             FontWeight="SemiBold"
                             Margin="0,14,0,0" />
                  <TextBlock Text="{Binding ScanStatus}"
                             Foreground="{DynamicResource NexusText}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             LineHeight="21"
                             Margin="0,9,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="24,0,0,0">
                  <TextBlock Text="NEXUS"
                             FontSize="12"
                             FontWeight="Bold"
                             Foreground="{DynamicResource NexusText}"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="01"
                             FontSize="46"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource NexusText}"
                             HorizontalAlignment="Right"
                             Margin="0,-4,0,0" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <UniformGrid Columns="3" Margin="0,0,0,30">
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="GAMES" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding GameCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="Ready when you are" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Background="#217B6CFF">
                  <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="APPLICATIONS" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding AppCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="Work and utilities" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Background="#1E48B9D6">
                  <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="FAVORITES" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding FavoriteCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="Pinned for quick launch" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Background="#2CDB9A55">
                  <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
          </UniformGrid>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Recently launched" Style="{StaticResource SectionTitle}" />
            <TextBlock Grid.Column="1" Text="Activity stays on this PC" Foreground="{DynamicResource NexusMutedText}" FontSize="12" VerticalAlignment="Center" />
          </Grid>
          <Border Margin="0,0,0,14" Padding="16,13">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding HasRecentItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Image Source="Assets/nexus-logo-512.png" Width="34" Height="34" Margin="0,0,12,0" />
              <StackPanel VerticalAlignment="Center"><TextBlock Text="Nothing launched yet" FontWeight="SemiBold" /><TextBlock Text="Launch something from Library and it will appear here." Foreground="{DynamicResource NexusMutedText}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
            </StackPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Margin="0,0,0,28">
            <ItemsControl ItemsSource="{Binding ContinuePlaying}" ItemTemplate="{StaticResource MiniItem}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Your favorites" Style="{StaticResource SectionTitle}" />
            <TextBlock Grid.Column="1" Text="Mark titles in Library to pin them here" Foreground="{DynamicResource NexusMutedText}" FontSize="12" VerticalAlignment="Center" />
          </Grid>
          <Border Margin="0,0,0,14" Padding="16,13">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding HasFavorites}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource NexusSelected}" Margin="0,0,12,0"><TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="No favorites yet" FontWeight="SemiBold" /><TextBlock Text="Choose Favorite on any library item to pin it here." Foreground="{DynamicResource NexusMutedText}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
            </StackPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource MiniItem}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
      <Grid Margin="30,26,30,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="YOUR COLLECTION" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding AddExecutableCommand}" Style="{StaticResource QuietButton}" Margin="0,0,10,0" AutomationProperties.Name="Add executable">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Add executable" /></StackPanel>
            </Button>
            <Button Style="{StaticResource AccentButton}" Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Rescan library">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Rescan" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Height="44" Background="{DynamicResource NexusPanel}" Style="{StaticResource SearchFieldBorder}" CornerRadius="11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource NexusMutedText}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBox Grid.Column="1"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Search your library"
                       AutomationProperties.Name="Search library"
                       BorderThickness="0"
                       Background="Transparent"
                       VerticalContentAlignment="Center"
                       Padding="0,0,12,0" />
            </Grid>
          </Border>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="12,0,0,0" AutomationProperties.Name="Library category" />
          <Border Grid.Column="2" Style="{StaticResource SmallPill}" Background="Transparent" BorderBrush="{DynamicResource NexusBorder}" Margin="12,0,0,0">
            <CheckBox Content="Show hidden" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center" />
          </Border>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,18,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="LIBRARY ITEMS" Style="{StaticResource Eyebrow}" />
                <TextBlock Grid.Column="1" Text="Select a title for details" Foreground="{DynamicResource NexusMutedText}" FontSize="11" />
              </Grid>
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding SelectedItem}"
                       ItemContainerStyle="{StaticResource LibraryItemContainer}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:LibraryItem}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="42" Height="42" CornerRadius="13" VerticalAlignment="Center" Background="#257B6CFF" ClipToBounds="True">
                        <Grid>
                          <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                              <MultiBinding Converter="{StaticResource LibraryIconConverter}">
                                <Binding Path="IconPath" />
                                <Binding Path="ExecutablePath" />
                              </MultiBinding>
                            </Image.Source>
                          </Image>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource NexusMutedText}" FontSize="11" />
                          <TextBlock Text="•" Foreground="{DynamicResource NexusMutedText}" Margin="6,0" FontSize="11" />
                          <TextBlock Text="{Binding DisplayProvider}" Foreground="{DynamicResource NexusMutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LaunchActivityDisplay}" Foreground="{DynamicResource NexusMutedText}" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Text="★" Foreground="#F5C451" FontSize="12" HorizontalAlignment="Right" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" Margin="0,3,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="1" Background="Transparent" Padding="24">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasVisibleItems}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                  <Image Source="Assets/nexus-logo-512.png" Width="52" Height="52" Opacity="0.82" />
                  <TextBlock Text="Nothing matches this view" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0" />
                  <TextBlock Text="Try another search or category, rescan, or add an executable." Foreground="{DynamicResource NexusMutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24">
            <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Border Width="58" Height="58" CornerRadius="18" Background="#1D7B6CFF" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Pick something to launch" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,0" TextAlignment="Center" />
              <TextBlock Text="Select a game or application to see its details and quick actions."
                         Foreground="{DynamicResource NexusMutedText}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         LineHeight="20"
                         Margin="0,7,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding SelectedItem}">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type models:LibraryItem}">
                  <StackPanel>
                    <Border Height="112" CornerRadius="15" ClipToBounds="True" Margin="0,0,0,20">
                      <Grid>
                        <Border>
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Color="#7B6CFF" Offset="0" />
                              <GradientStop Color="#243B7A" Offset="1" />
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <Ellipse Width="170" Height="170" Fill="#38FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-82,-55,0" />
                        <Border Width="62" Height="62" CornerRadius="18" Background="#D9212745" Margin="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" ClipToBounds="True">
                          <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality">
                              <Image.Source>
                                <MultiBinding Converter="{StaticResource LibraryIconConverter}">
                                  <Binding Path="IconPath" />
                                  <Binding Path="ExecutablePath" />
                                </MultiBinding>
                              </Image.Source>
                            </Image>
                          </Grid>
                        </Border>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DisplayProvider}" Foreground="{DynamicResource NexusMutedText}" Margin="0,5,0,20" />
                    <Button Style="{StaticResource AccentButton}" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Margin="0,0,0,9" AutomationProperties.Name="Launch selected item">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Launch" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Margin="0,0,0,20" AutomationProperties.Name="Open installation folder">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Open installation folder" /></StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource NexusBorder}" Margin="0,0,0,18" />
                    <TextBlock Text="DETAILS" Style="{StaticResource Eyebrow}" />
                    <Grid Margin="0,11,0,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="CATEGORY" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NexusMutedText}" />
                        <TextBlock Text="{Binding CategoryLabel}" Margin="0,4,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="VERSION" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NexusMutedText}" />
                        <TextBlock Text="{Binding VersionDisplay}" Margin="0,4,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="PUBLISHER" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NexusMutedText}" />
                    <TextBlock Text="{Binding PublisherDisplay}" Margin="0,4,0,15" TextWrapping="Wrap" />
                    <TextBlock Text="DESCRIPTION" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NexusMutedText}" />
                    <TextBlock Text="{Binding DescriptionDisplay}" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="0,5,0,15" TextWrapping="Wrap" MaxHeight="84" TextTrimming="WordEllipsis" />
                    <TextBlock Text="INSTALLATION" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource NexusMutedText}" />
                    <TextBlock Text="{Binding InstallLocationDisplay}" Foreground="{DynamicResource NexusMutedText}" FontSize="11" Margin="0,5,0,18" TextWrapping="Wrap" />
                    <WrapPanel>
                      <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" AutomationProperties.Name="{Binding FavoriteActionLabel}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="{Binding FavoriteActionLabel}" /></StackPanel></Button>
                      <Button Command="{Binding DataContext.AiMetadataCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Style="{StaticResource QuietButton}" ToolTip="Enable metadata intelligence in Settings, choose On-device AI or Nexus Cloud, then review suggestions before applying them." AutomationProperties.Name="Request metadata suggestion" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="AI metadata" /></StackPanel></Button>
                      <Button Command="{Binding DataContext.HideCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" AutomationProperties.Name="{Binding VisibilityActionLabel}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="{Binding VisibilityActionLabel}" /></StackPanel></Button>
                      <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Background="{DynamicResource NexusDangerSurface}" BorderBrush="{DynamicResource NexusDangerBorder}" Margin="0,0,0,8" AutomationProperties.Name="Remove from Nexus"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Remove" /></StackPanel></Button>
                    </WrapPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="2,14,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StoreViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalFirst">
      <Grid Margin="30,26,30,30" MinHeight="650">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="DISCOVER, DON'T COMPROMISE" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
          <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,0" />
          <Border Height="112" Margin="0,22,0,0" CornerRadius="18" ClipToBounds="True" BorderBrush="#5A7B6CFF" BorderThickness="1">
            <Grid>
              <Border Background="#11182B" />
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#503B2B8E" Offset="0" />
                    <GradientStop Color="#24425DD4" Offset="0.55" />
                    <GradientStop Color="#25111B32" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Ellipse Width="230" Height="230" Fill="#247B6CFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-75,0" />
              <Grid Margin="22,17">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="ONE SEARCH, TRUSTED NEXT STEPS" FontSize="10" FontWeight="Bold" Foreground="#D8E7EEFF" />
                  <TextBlock Text="Steam games and WinGet software" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0" />
                  <TextBlock Text="Nexus never claims ownership or bypasses the original provider." Foreground="#D8E7EEFF" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SmallPill}" Background="#2410172B" BorderBrush="#487B6CFF" VerticalAlignment="Center">
                  <TextBlock Text="Local-first" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,22,0,18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="172" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SelectedScope}" VerticalContentAlignment="Center" AutomationProperties.Name="Store search scope" />
            <Border Grid.Column="1" Height="44" Margin="12,0,0,0" Style="{StaticResource SearchFieldBorder}" CornerRadius="11">
              <Grid>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource NexusMutedText}" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SearchPlaceholder}" AutomationProperties.Name="{Binding SearchPlaceholder}" BorderThickness="0" Background="Transparent" Padding="38,7,12,7" VerticalContentAlignment="Center">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding SearchPlaceholder}"
                           Foreground="{DynamicResource NexusMutedText}"
                           Margin="38,0,12,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Query}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}" Margin="12,0,0,0" AutomationProperties.Name="{Binding SearchButtonText}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="{Binding SearchButtonText}" /></StackPanel></Button>
          </Grid>
        </Border>

        <Grid Grid.Row="2" MinHeight="260" MaxHeight="360">
          <Border Padding="28" VerticalAlignment="Top">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasResults}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
              <Border Width="52" Height="52" Background="#267B6CFF" CornerRadius="16" HorizontalAlignment="Center">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,17,0,0" />
              <TextBlock Text="{Binding EmptyStateBody}" Foreground="{DynamicResource NexusMutedText}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" />
            </StackPanel>
          </Border>

          <Border Padding="8">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasResults}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" ItemContainerStyle="{StaticResource LibraryItemContainer}" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:StorePackage}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="104" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="88" Height="54" CornerRadius="10" Background="{DynamicResource NexusSelected}" ClipToBounds="True" VerticalAlignment="Center">
                      <Grid>
                        <Image Source="Assets/nexus-cover-fallback.png" Stretch="UniformToFill" Opacity="0.78" />
                        <infra:SafeRemoteImage Url="{Binding ImageUrl}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                        <Border Style="{StaticResource SmallPill}" Margin="9,0,0,0" Padding="7,3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource NexusMutedText}" />
                        </Border>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource NexusMutedText}" FontSize="12" />
                        <TextBlock Text="{Binding PlatformSummary}" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="12,0,0,0" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding PriceDisplay}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding ActionHint}" Foreground="{DynamicResource NexusMutedText}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,15,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NexusMutedText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Steam applies its own account, regional, and age checks after Nexus opens the official page." Foreground="{DynamicResource NexusMutedText}" FontSize="11" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding PrimaryActionCommand}" Style="{StaticResource AccentButton}" Margin="18,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding PrimaryActionLabel}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="{Binding PrimaryActionLabel}" /></StackPanel></Button>
        </Grid>
      </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ModsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,30" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="LOCAL MODS" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
          <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,26" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Width="44" Height="44" Background="#217B6CFF" CornerRadius="14" HorizontalAlignment="Left">
                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Install a local ZIP archive" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0" />
              <TextBlock Text="Nexus extracts only the ZIP archive you choose and validates every path before writing to the selected game’s Mods folder."
                         Foreground="{DynamicResource NexusMutedText}"
                         TextWrapping="Wrap"
                         LineHeight="22"
                         Margin="0,8,0,22" />
              <TextBlock Text="Game" Style="{StaticResource Eyebrow}" />
              <ComboBox ItemsSource="{Binding Games}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGame}" Margin="0,7,0,14" AutomationProperties.Name="Game for mod import" />
              <Border Background="{DynamicResource NexusHover}" BorderBrush="{DynamicResource NexusBorder}" BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,0,18">
                <TextBlock Text="{Binding ModFolder}" Foreground="{DynamicResource NexusMutedText}" TextWrapping="Wrap" />
              </Border>
              <WrapPanel>
                <Button Content="Import ZIP archive" Style="{StaticResource AccentButton}" Command="{Binding ImportZipCommand}" Margin="0,0,10,0" />
                <Button Content="Open Mods folder" Style="{StaticResource QuietButton}" Command="{Binding OpenFolderCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NexusMutedText}" Margin="0,18,0,0" TextWrapping="Wrap" AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CollectionsViewModel}">
      <Grid Margin="30,26,30,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="CURATE YOUR SPACE" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
          <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,0" />
        </StackPanel>
        <ComboBox Grid.Row="1" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" Width="220" HorizontalAlignment="Left" Margin="0,24,0,18" AutomationProperties.Name="Collection view" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
          <Grid>
          <ListBox ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource LibraryItemContainer}" AutomationProperties.Name="Collection items">
            <ListBox.Style>
              <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasItems}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.Style>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type models:LibraryItem}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="12" Background="#217B6CFF" ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                          <MultiBinding Converter="{StaticResource LibraryIconConverter}">
                            <Binding Path="IconPath" />
                            <Binding Path="ExecutablePath" />
                          </MultiBinding>
                        </Image.Source>
                      </Image>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DisplayProvider}" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="0,3,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding LaunchActivityDisplay}" Foreground="{DynamicResource NexusMutedText}" VerticalAlignment="Center" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Padding="28">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasItems}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
              <Border Width="52" Height="52" Background="#267B6CFF" CornerRadius="16" HorizontalAlignment="Center">
                <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,17,0,0" />
              <TextBlock Text="{Binding EmptyStateText}"
                         Foreground="{DynamicResource NexusMutedText}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         LineHeight="21"
                         Margin="0,7,0,0"
                         AutomationProperties.Name="{Binding EmptyStateText}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CloudViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,30" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="BACKUP AND RESTORE" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
          <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,26" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Width="44" Height="44" Background="#217B6CFF" CornerRadius="14" HorizontalAlignment="Left">
                <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Move your library on your terms" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0" />
              <TextBlock Text="Nexus creates a local ZIP backup of your library and settings. It does not upload it, create an account, or connect a cloud service."
                         Foreground="{DynamicResource NexusMutedText}"
                         TextWrapping="Wrap"
                         LineHeight="22"
                         Margin="0,8,0,22" />
              <WrapPanel>
                <Button Content="Export backup" Style="{StaticResource AccentButton}" Command="{Binding ExportCommand}" Margin="0,0,10,0" />
                <Button Content="Restore backup" Style="{StaticResource QuietButton}" Command="{Binding RestoreCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NexusMutedText}" Margin="0,18,0,0" TextWrapping="Wrap" AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,30" MaxWidth="920" HorizontalAlignment="Left">
          <TextBlock Text="PREFERENCES" Style="{StaticResource Eyebrow}" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
          <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,26" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Choose how Nexus follows your desktop theme." Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,15" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Application theme" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Library scanning" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Choose only the local sources you want Nexus to check." Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,13" />
              <CheckBox Content="Check registered Windows applications" IsChecked="{Binding IncludeInstalledApplications}" Margin="0,5,0,5" />
              <CheckBox Content="Check Start menu shortcuts" IsChecked="{Binding IncludeStartMenuShortcuts}" Margin="0,5,0,15" />
              <TextBlock Text="EXTRA SCAN FOLDERS" Style="{StaticResource Eyebrow}" />
              <ListBox ItemsSource="{Binding ScanFolders}" SelectedItem="{Binding SelectedScanFolder}" MaxHeight="120" Margin="0,8,0,12" AutomationProperties.Name="Extra scan folders">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource NexusMutedText}" Padding="8,5" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Content="Add folder" Command="{Binding AddScanFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,0,10,0" />
                <Button Content="Remove selected" Command="{Binding RemoveScanFolderCommand}" Style="{StaticResource QuietButton}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Privacy" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Nexus stays local-first. Library scanning and launching do not need an account or online service. On-device metadata intelligence runs in an isolated local Ollama process with cloud access disabled. Nexus Cloud sends only a minimized metadata request after you explicitly select that provider and request a suggestion."
                         Foreground="{DynamicResource NexusMutedText}"
                         TextWrapping="Wrap"
                         LineHeight="22"
                         Margin="0,9,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" Background="#267B6CFF" CornerRadius="13" Margin="0,0,13,0">
                  <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Metadata intelligence" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Private by default · review before apply" Foreground="{DynamicResource NexusMutedText}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Choose exactly one provider. Nexus never silently falls back between on-device and cloud processing, never embeds an OpenAI API key, and never lets a suggestion change launch settings."
                         Foreground="{DynamicResource NexusMutedText}"
                         TextWrapping="Wrap"
                         LineHeight="22"
                         Margin="0,12,0,15" />
              <CheckBox Content="Enable metadata intelligence" IsChecked="{Binding EnableAiMetadata}" Margin="0,0,0,16" />

              <TextBlock Text="PROVIDER" Style="{StaticResource Eyebrow}" />
              <ComboBox ItemsSource="{Binding AiProviders}"
                        SelectedItem="{Binding SelectedAiProvider}"
                        DisplayMemberPath="Name"
                        AutomationProperties.Name="Metadata provider"
                        Margin="0,7,0,5" />
              <TextBlock Text="{Binding SelectedAiProvider.Summary}" Foreground="{DynamicResource NexusMutedText}" TextWrapping="Wrap" Margin="1,0,0,16" />

              <Border Background="{DynamicResource NexusHover}"
                      BorderBrush="{DynamicResource NexusBorder}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="15"
                      Margin="0,0,0,14"
                      Visibility="{Binding IsLocalAiProvider, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ON-DEVICE GUARANTEES" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Nexus launches its own loopback-only Ollama process, disables Ollama Cloud, uses compatible downloaded text-generation models only, and never enables tools or web access."
                               Foreground="{DynamicResource NexusMutedText}"
                               TextWrapping="Wrap"
                               MaxWidth="640"
                               Margin="0,6,16,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Command="{Binding OpenLocalAiSetupCommand}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.Name="Get Ollama from the official site">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Get Ollama" /></StackPanel>
                  </Button>
                </Grid>
              </Border>

              <Border Background="{DynamicResource NexusHover}"
                      BorderBrush="{DynamicResource NexusBorder}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="15"
                      Margin="0,0,0,14"
                      Visibility="{Binding IsCloudAiProvider, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="NEXUS CLOUD" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="This optional provider appears only when a maintainer configures a trusted Nexus OAuth gateway. It is a Nexus sign-in, not an OpenAI account sign-in."
                             Foreground="{DynamicResource NexusMutedText}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,13" />
                  <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="MONTHLY REQUEST LIMIT" Style="{StaticResource Eyebrow}" />
                      <ComboBox ItemsSource="{Binding AiRequestLimits}" SelectedItem="{Binding AiMonthlyRequestLimit}" Width="110" Margin="0,7,0,0" AutomationProperties.Name="AI monthly request limit" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding AiUsageDescription}" Foreground="{DynamicResource NexusMutedText}" VerticalAlignment="Bottom" Margin="18,0,0,2" />
                  </Grid>
                  <WrapPanel>
                    <Button Command="{Binding ConnectAiCommand}" Style="{StaticResource AccentButton}" Margin="0,0,10,0" AutomationProperties.Name="Connect Nexus Cloud"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Connect Nexus Cloud" /></StackPanel></Button>
                    <Button Command="{Binding DisconnectAiCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Disconnect Nexus Cloud"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Disconnect" /></StackPanel></Button>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource NexusSelected}" BorderBrush="{DynamicResource NexusBorderStrong}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding AiConnectionStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,14,0" AutomationProperties.Name="{Binding AiConnectionStatus}" AutomationProperties.LiveSetting="Polite" />
                  <Button Grid.Column="2" Command="{Binding RefreshAiStatusCommand}" Style="{StaticResource QuietButton}" Padding="10,6" AutomationProperties.Name="Refresh metadata provider status"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Refresh" /></StackPanel></Button>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding DataStorageDescription}" Foreground="{DynamicResource NexusMutedText}" TextWrapping="Wrap" Margin="0,8,0,15" />
              <WrapPanel>
                <Button Content="Open data folder" Command="{Binding OpenDataCommand}" Style="{StaticResource QuietButton}" Margin="0,0,10,0" />
                <Button Content="Save settings" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NexusMutedText}" Margin="0,14,0,0" AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InfoPageViewModel}">
      <StackPanel Margin="30,26,30,30" MaxWidth="820">
        <TextBlock Text="NEXUS" Style="{StaticResource Eyebrow}" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,7,0,0" />
        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource NexusMutedText}" Margin="0,7,0,26" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Width="46" Height="46" Background="#217B6CFF" CornerRadius="14" HorizontalAlignment="Left">
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource NexusText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0" />
            <TextBlock Text="{Binding Body}" Foreground="{DynamicResource NexusMutedText}" TextWrapping="Wrap" LineHeight="23" Margin="0,9,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{DynamicResource NexusBackground}" SnapsToDevicePixels="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="SidebarShell" Background="{DynamicResource NexusSidebar}" BorderBrush="{DynamicResource NexusBorder}" BorderThickness="0,0,1,0">
      <Grid Margin="14,20,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="9,0,7,25">
          <Border Width="38" Height="38" CornerRadius="12" ClipToBounds="True">
            <Image Source="Assets/nexus-logo-512.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="17" />
            <TextBlock Text="LOCAL LAUNCHER" Foreground="{DynamicResource NexusMutedText}" FontSize="9" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="LIBRARY" Style="{StaticResource Eyebrow}" Margin="10,0,0,9" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Navigation}"
                   SelectedItem="{Binding SelectedNavigation}"
                   ItemContainerStyle="{StaticResource SidebarItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type infra:NavigationItem}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                             FontSize="15"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <StackPanel Grid.Row="2">
          <Border Background="{DynamicResource NexusHover}" BorderBrush="{DynamicResource NexusBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="LOCAL-FIRST" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="No account. No tracking." Foreground="{DynamicResource NexusMutedText}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Button Content="Command palette"
                  Command="{Binding OpenCommandPaletteCommand}"
                  Style="{StaticResource QuietButton}"
                  HorizontalAlignment="Stretch"
                  Foreground="{DynamicResource NexusMutedText}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="ContentShell" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="68" />
        <RowDefinition Height="*" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>
      <Image Grid.RowSpan="3"
             Source="Assets/nexus-ambient.png"
             Stretch="UniformToFill"
             Opacity="0.11"
             IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="LowQuality"
             CacheMode="BitmapCache" />
      <Border Background="{DynamicResource NexusHeader}" BorderBrush="{DynamicResource NexusBorder}" BorderThickness="0,0,0,1">
        <Grid Margin="30,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedNavigation.Title}" FontSize="14" FontWeight="SemiBold" />
            <Border Style="{StaticResource SmallPill}" Margin="12,0,0,0" Padding="7,3">
              <TextBlock Text="Ctrl + K" Foreground="{DynamicResource NexusMutedText}" FontSize="10" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="&#xE721;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    ToolTip="Open command palette"
                    AutomationProperties.Name="Open command palette"
                    Command="{Binding OpenCommandPaletteCommand}"
                    Style="{StaticResource QuietButton}"
                    Padding="9,6"
                    Margin="0,0,9,0" />
            <Button Command="{Binding ScanCommand}"
                    Style="{StaticResource AccentButton}"
                    AutomationProperties.Name="Rescan library"
                    Padding="14,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Rescan" /></StackPanel></Button>
          </StackPanel>
        </Grid>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      <Border Grid.Row="2" Background="{DynamicResource NexusPanel}" BorderBrush="{DynamicResource NexusBorder}" BorderThickness="0,1,0,0" Padding="30,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding GlobalStatus}" Foreground="{DynamicResource NexusMutedText}" FontSize="11" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding GlobalStatus}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Grid.Column="1" Text="NEXUS · LOCAL MODE" Foreground="{DynamicResource NexusMutedText}" FontSize="10" FontWeight="SemiBold" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.ColumnSpan="2"
            Background="{DynamicResource NexusScrim}"
            Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid x:Name="CommandPaletteDialog"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,56,0,0"
            Width="640"
            FocusManager.IsFocusScope="True"
            KeyboardNavigation.TabNavigation="Cycle"
            AutomationProperties.Name="Command palette">
        <Border Background="{DynamicResource NexusPanelRaised}" CornerRadius="18" Padding="14" BorderBrush="{DynamicResource NexusBorderStrong}" BorderThickness="1">
          <StackPanel>
            <Grid>
              <Border Height="50" Background="{DynamicResource NexusPanel}" Style="{StaticResource SearchFieldBorder}" CornerRadius="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource NexusMutedText}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBox x:Name="CommandPaletteSearchBox" Grid.Column="1" Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="16" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" ToolTip="Search commands" AutomationProperties.Name="Search commands" />
                </Grid>
              </Border>
              <Button Content="&#xE711;"
                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                      Command="{Binding CloseCommandPaletteCommand}"
                      Style="{StaticResource QuietButton}"
                      AutomationProperties.Name="Close command palette"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      Padding="6,3"
                      BorderThickness="0" />
            </Grid>
            <TextBlock Text="COMMANDS" Style="{StaticResource Eyebrow}" Margin="8,16,0,6" />
            <ListBox ItemsSource="{Binding FilteredPaletteCommands}" BorderThickness="0" MaxHeight="270" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type infra:PaletteCommand}">
                  <Button Command="{Binding Command}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Stretch" Padding="14,11" AutomationProperties.Name="{Binding Name}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource NexusMutedText}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.ColumnSpan="2"
            Background="{DynamicResource NexusScrim}"
            Visibility="{Binding IsOnboardingOpen, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="OnboardingDialog"
              Background="{DynamicResource NexusPanelRaised}"
              Width="650"
              Padding="42"
              CornerRadius="22"
              BorderBrush="{DynamicResource NexusBorderStrong}"
              BorderThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="Nexus first-run setup">
        <StackPanel>
          <Border Style="{StaticResource SmallPill}" HorizontalAlignment="Left" Background="#197B6CFF" BorderBrush="#4E9A8CFF">
            <TextBlock Text="NEXUS · FIRST RUN" FontSize="10" FontWeight="Bold" />
          </Border>
          <TextBlock Text="{Binding OnboardingTitle}" FontSize="31" FontWeight="SemiBold" Margin="0,17,0,0" />
          <TextBlock Text="{Binding OnboardingBody}" Foreground="{DynamicResource NexusMutedText}" FontSize="15" TextWrapping="Wrap" LineHeight="24" Margin="0,12,0,31" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button Content="Back" Command="{Binding PreviousOnboardingCommand}" Style="{StaticResource QuietButton}" Margin="0,0,10,0" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding OnboardingStep, StringFormat=Step {0} of 3}" Foreground="{DynamicResource NexusMutedText}" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="OnboardingNextButton" Content="Next" Command="{Binding NextOnboardingCommand}" Style="{StaticResource AccentButton}" Margin="0,0,10,0" Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVisibility}}" />
              <Button x:Name="OnboardingStartButton" Content="Start Nexus" Style="{StaticResource AccentButton}" Command="{Binding FinishOnboardingCommand}" Visibility="{Binding CanFinishOnboarding, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
