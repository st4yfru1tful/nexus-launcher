<Window x:Class="NexusLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexusLauncher.App.ViewModels"
        xmlns:models="clr-namespace:NexusLauncher.App.Models"
        xmlns:infra="clr-namespace:NexusLauncher.App.Infrastructure"
        Title="Nexus Launcher" Width="1380" Height="840" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
  <Window.InputBindings>
    <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="SidebarItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="Margin" Value="7,2" />
      <Setter Property="Foreground" Value="{StaticResource NexusMutedText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="surface" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="surface" Property="Background" Value="#30315C" /><Setter Property="Foreground" Value="{StaticResource NexusText}" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#242B3A" /><Setter Property="Foreground" Value="{StaticResource NexusText}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource NexusPanel}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource NexusText}" />
    </Style>
    <DataTemplate x:Key="MiniItem" DataType="{x:Type models:LibraryItem}">
      <Border Background="{StaticResource NexusPanelRaised}" CornerRadius="10" Padding="11" Width="170" Height="94" Margin="0,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource NexusAccent}" VerticalAlignment="Top">
            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
          </Border>
          <StackPanel Grid.Column="1" Margin="5,0,0,0">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DisplayProvider}" Foreground="{StaticResource NexusMutedText}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding PlaytimeDisplay}" Foreground="{StaticResource NexusMutedText}" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="↻  Rescan library" Style="{StaticResource AccentButton}" Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </Grid>
          <Border Style="{StaticResource Card}" Background="#252657" Margin="0,0,0,20">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Nexus is ready for your library" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ScanStatus}" Foreground="#D8D7FF" Margin="0,6,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="⌁" FontSize="42" Foreground="#B8B0FF" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <UniformGrid Columns="3" Margin="0,0,0,28">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="GAMES" Foreground="{StaticResource NexusMutedText}" FontSize="11" /><TextBlock Text="{Binding GameCount}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="APPLICATIONS" Foreground="{StaticResource NexusMutedText}" FontSize="11" /><TextBlock Text="{Binding AppCount}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FAVORITES" Foreground="{StaticResource NexusMutedText}" FontSize="11" /><TextBlock Text="{Binding FavoriteCount}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="Continue playing" Style="{StaticResource SectionTitle}" Margin="0,0,0,11" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,26">
            <ItemsControl ItemsSource="{Binding ContinuePlaying}" ItemTemplate="{StaticResource MiniItem}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Favorites" Style="{StaticResource SectionTitle}" Margin="0,0,0,11" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource MiniItem}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
      <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="+ Add executable" Command="{Binding AddExecutableCommand}" Margin="0,0,8,0" />
            <Button Content="↻ Rescan" Style="{StaticResource AccentButton}" Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,22,0,15">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Search your library" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="10,0,0,0" />
          <CheckBox Grid.Column="2" Content="Show hidden" IsChecked="{Binding ShowHidden}" Margin="15,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="6" Margin="0,0,15,0">
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:LibraryItem}">
                  <Border Padding="12" Margin="0,1" CornerRadius="8" Background="Transparent">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource NexusAccent}" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                      <StackPanel Grid.Column="1" Margin="2,0,10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource NexusMutedText}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding DisplayProvider}" Foreground="{StaticResource NexusMutedText}" FontSize="12" HorizontalAlignment="Right" /><TextBlock Text="{Binding PlaytimeDisplay}" Foreground="{StaticResource NexusMutedText}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" /></StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}">
            <ContentControl Content="{Binding SelectedItem}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type models:LibraryItem}">
                  <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="14" Background="{StaticResource NexusAccent}" HorizontalAlignment="Left"><TextBlock Text="{Binding Initial}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DisplayProvider}" Foreground="{StaticResource NexusMutedText}" Margin="0,3,0,16" />
                    <Button Content="▶  Launch" Style="{StaticResource AccentButton}" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Margin="0,0,0,8" />
                    <Button Content="Open installation folder" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Margin="0,0,0,12" />
                    <Separator Background="#39435A" Margin="0,0,0,12" />
                    <TextBlock Text="DETAILS" Foreground="{StaticResource NexusMutedText}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding CategoryLabel}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource NexusMutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource NexusMutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding InstallPath}" Foreground="{StaticResource NexusMutedText}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <WrapPanel><Button Content="★ Favorite" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Margin="0,0,8,8" /><Button Content="Hide" Command="{Binding DataContext.HideCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" Margin="0,0,8,8" /><Button Content="Remove" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}" /></WrapPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{StaticResource NexusMutedText}" Margin="0,12,0,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StoreViewModel}">
      <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,0" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Search WinGet" /><Button Grid.Column="1" Content="Search WinGet" Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}" Margin="10,0,0,0" /></Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
          <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type models:StorePackage}">
                <Border Padding="13" Margin="0,1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Id}" Foreground="{StaticResource NexusMutedText}" FontSize="12" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource NexusMutedText}" VerticalAlignment="Center" /></Grid></Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{StaticResource NexusMutedText}" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Install selected" Command="{Binding InstallCommand}" Margin="15,0,0,0" /></Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,24,32,32">
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,24" />
        <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left"><StackPanel>
          <TextBlock Text="Local ZIP mod installation" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="This tool is deliberately conservative: it only extracts ZIP files and checks every archive path. It is for games that document a Mods folder as the correct destination." Foreground="{StaticResource NexusMutedText}" TextWrapping="Wrap" Margin="0,8,0,18" />
          <TextBlock Text="Game" Foreground="{StaticResource NexusMutedText}" /><ComboBox ItemsSource="{Binding Games}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGame}" Margin="0,6,0,14" />
          <TextBlock Text="{Binding ModFolder}" Foreground="{StaticResource NexusMutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />
          <WrapPanel><Button Content="Import ZIP archive" Style="{StaticResource AccentButton}" Command="{Binding ImportZipCommand}" Margin="0,0,8,0" /><Button Content="Open Mods folder" Command="{Binding OpenFolderCommand}" /></WrapPanel>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource NexusMutedText}" Margin="0,16,0,0" TextWrapping="Wrap" />
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CollectionsViewModel}">
      <Grid Margin="32,24,32,32"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,0" /></StackPanel>
        <ComboBox Grid.Row="1" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" Width="210" HorizontalAlignment="Left" Margin="0,24,0,15" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6"><ListBox ItemsSource="{Binding Items}"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:LibraryItem}"><Border Padding="13" Margin="0,1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource NexusAccent}"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding DisplayProvider}" Foreground="{StaticResource NexusMutedText}" FontSize="12" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding PlaytimeDisplay}" Foreground="{StaticResource NexusMutedText}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CloudViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,24,32,32"><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,24" />
        <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left"><StackPanel><TextBlock Text="Move your library on your terms" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Nexus v0.1 creates a local ZIP backup containing your library and settings. It does not encrypt it, upload it, or connect an account. Keep backups somewhere you trust." Foreground="{StaticResource NexusMutedText}" TextWrapping="Wrap" Margin="0,8,0,18" /><WrapPanel><Button Content="Export backup" Style="{StaticResource AccentButton}" Command="{Binding ExportCommand}" Margin="0,0,8,0" /><Button Content="Restore backup" Command="{Binding RestoreCommand}" /></WrapPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource NexusMutedText}" Margin="0,16,0,0" TextWrapping="Wrap" /></StackPanel></Border>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,24,32,32" MaxWidth="850" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,24" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" /><TextBlock Text="Theme" Foreground="{StaticResource NexusMutedText}" Margin="0,14,0,5" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="150" HorizontalAlignment="Left" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Library scanning" Style="{StaticResource SectionTitle}" /><CheckBox Content="Check registered Windows applications" IsChecked="{Binding IncludeInstalledApplications}" Margin="0,14,0,5" /><CheckBox Content="Check Start menu shortcuts" IsChecked="{Binding IncludeStartMenuShortcuts}" Margin="0,5,0,14" /><TextBlock Text="Extra scan folders" Foreground="{StaticResource NexusMutedText}" /><ListBox ItemsSource="{Binding ScanFolders}" SelectedItem="{Binding SelectedScanFolder}" MaxHeight="110" Margin="0,6,0,10" /><WrapPanel><Button Content="Add folder" Command="{Binding AddScanFolderCommand}" Margin="0,0,8,0" /><Button Content="Remove selected" Command="{Binding RemoveScanFolderCommand}" /></WrapPanel></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Privacy" Style="{StaticResource SectionTitle}" /><TextBlock Text="Online metadata and AI identification are intentionally unavailable in this local-first v0.1 build. Nexus does not send executable metadata, files, library contents, or account data to any service." Foreground="{StaticResource NexusMutedText}" TextWrapping="Wrap" Margin="0,14,0,0" /></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" /><TextBlock Text="Your library and settings are stored under LocalAppData. No account is required." Foreground="{StaticResource NexusMutedText}" Margin="0,8,0,12" /><WrapPanel><Button Content="Open data folder" Command="{Binding OpenDataCommand}" Margin="0,0,8,0" /><Button Content="Save settings" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" /></WrapPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource NexusMutedText}" Margin="0,12,0,0" /></StackPanel></Border>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InfoPageViewModel}">
      <StackPanel Margin="32,24,32,32" MaxWidth="760"><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource NexusMutedText}" Margin="0,5,0,24" /><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Glyph}" FontSize="36" Foreground="{StaticResource NexusAccent}" /><TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding Body}" Foreground="{StaticResource NexusMutedText}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0" /></StackPanel></Border></StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="228" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#121722" BorderBrush="#273044" BorderThickness="0,0,1,0">
      <Grid Margin="10,18,10,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="11,0,0,18"><Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource NexusAccent}"><Viewbox Margin="7"><Path Fill="White" Data="M 0,0 L 10,0 10,10 20,10 20,20 10,20 10,30 0,30 Z M 20,0 L 30,0 30,30 20,30 Z" /></Viewbox></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="NEXUS" FontWeight="Bold" FontSize="16" /><TextBlock Text="LAUNCHER" Foreground="{StaticResource NexusMutedText}" FontSize="9" FontWeight="SemiBold" /></StackPanel></StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}" ItemContainerStyle="{StaticResource SidebarItem}"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type infra:NavigationItem}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Button Grid.Row="2" Content="⌘  Command palette" Command="{Binding OpenCommandPaletteCommand}" HorizontalAlignment="Stretch" Foreground="{StaticResource NexusMutedText}" />
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="31" /></Grid.RowDefinitions>
      <ContentControl Content="{Binding CurrentPage}" />
      <Border Grid.Row="1" Background="#121722" BorderBrush="#273044" BorderThickness="0,1,0,0" Padding="18,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding GlobalStatus}" Foreground="{StaticResource NexusMutedText}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="Ctrl+K" Foreground="{StaticResource NexusMutedText}" FontSize="12" /></Grid></Border>
    </Grid>
    <Border Grid.ColumnSpan="2" Background="#B010131C" Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}"><Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,130,0,0" Width="600"><Border Background="#202737" CornerRadius="14" Padding="12" BorderBrush="#59667F" BorderThickness="1"><StackPanel><Grid><TextBox Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="12" ToolTip="Search commands" /><Button Content="×" Command="{Binding CloseCommandPaletteCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Padding="8,2" Background="Transparent" BorderThickness="0" /></Grid><ListBox ItemsSource="{Binding FilteredPaletteCommands}" BorderThickness="0" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type infra:PaletteCommand}"><Button Command="{Binding Command}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource NexusMutedText}" FontSize="12" Margin="0,3,0,0" /></StackPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></Grid></Border>
    <Border Grid.ColumnSpan="2" Background="#E010131C" Visibility="{Binding IsOnboardingOpen, Converter={StaticResource BoolToVisibility}}"><Border Background="#202737" Width="600" Padding="38" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="NEXUS // FIRST RUN" Foreground="{StaticResource NexusAccent}" FontWeight="Bold" FontSize="12" /><TextBlock Text="{Binding OnboardingTitle}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding OnboardingBody}" Foreground="{StaticResource NexusMutedText}" FontSize="15" TextWrapping="Wrap" LineHeight="24" Margin="0,12,0,28" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="Back" Command="{Binding PreviousOnboardingCommand}" Margin="0,0,8,0" /><TextBlock Text="{Binding OnboardingStep, StringFormat=Step {0} of 3}" Foreground="{StaticResource NexusMutedText}" VerticalAlignment="Center" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Next" Command="{Binding NextOnboardingCommand}" Margin="0,0,8,0" /><Button Content="Start Nexus" Style="{StaticResource AccentButton}" Command="{Binding FinishOnboardingCommand}" /></StackPanel></Grid></StackPanel></Border></Border>
  </Grid>
</Window>
